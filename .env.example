SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Signup uses email OTP (not magic links): Supabase Dashboard → Authentication → Email Templates
# → "Confirm signup" must include {{ .Token }}; enable "Confirm email" under Email provider.
ANTHROPIC_API_KEY=
# Claude models — Sonnet for hero/pricing/CTA; Haiku for site type + other sections
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Web search off by default (visual UX audits do not need it)
ANTHROPIC_WEB_SEARCH_ENABLED=false
ANTHROPIC_WEB_SEARCH_MAX_USES=3

# Analysis optimization
AUDIT_ANALYSIS_MAX_TOKENS=2000
AUDIT_ANALYSIS_MAX_ISSUES=8
AUDIT_ANALYSIS_IMAGE_MAX_WIDTH=1024
AUDIT_ANALYSIS_HERO_IMAGE_MAX_WIDTH=1280
AUDIT_ANALYSIS_IMAGE_QUALITY=85
AUDIT_ANALYSIS_CONCURRENCY=3
AUDIT_ANALYSIS_TOKEN_BUDGET_PER_MIN=28000
AUDIT_ANALYSIS_ESTIMATED_INPUT_TOKENS=4500
AUDIT_PARALLEL_ANALYSIS=true
# Pipeline analysis during capture (buffer-first, overlaps with upload/capture)
AUDIT_PIPELINE_ANALYSIS=true
# Skip mobile full-page PNG (report uses section clips; desktop full-page kept)
AUDIT_SKIP_MOBILE_FULL_PAGE=true
STORAGE_BUCKET=screenshot-engine
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Aliases accepted by the audit engine (STORAGE_BUCKET / R2_PUBLIC_BASE_URL also work)
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PUBLIC_BASE_URL=

# Superadmin panel — comma-separated emails or user UUIDs allowed to access /admin
SUPERADMIN_EMAILS=
SUPERADMIN_PIN=
# SUPERADMIN_USER_IDS=

# Max concurrent audits per Node process. Each audit spins up Chromium + makes
# Claude Vision calls, so 2 is a safe default for a small box. Extra jobs queue
# in the "pending" state and start when a slot frees up.
MAX_CONCURRENT_AUDITS=2

# Audit engine — navigation and load tolerance (milliseconds)
AUDIT_NAV_TIMEOUT_MS=90000
AUDIT_NAV_RETRIES=2
AUDIT_LOAD_TIMEOUT_MS=30000
AUDIT_NETWORK_IDLE_MS=10000
AUDIT_SETTLE_MS=1200
AUDIT_CONTENT_TIMEOUT_MS=20000
AUDIT_IMAGE_TIMEOUT_MS=12000
# accept | reject — accept reveals full page content for UX review
AUDIT_COOKIE_STRATEGY=accept

# Fast capture (default on): parallel desktop+mobile, shorter waits, DOM-first section detect.
# Set AUDIT_FAST_CAPTURE=false to restore legacy sequential + longer waits.
AUDIT_FAST_CAPTURE=true
AUDIT_PARALLEL_VIEWPORTS=true
# Per-section lazy-image wait before clip screenshot (ms)
AUDIT_SECTION_IMAGE_TIMEOUT_MS=800
